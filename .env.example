# Environment Variables for Git-Based MCP Todo Server
# Copy this file to .env and update with your values

# REQUIRED: Path to your Git repository for storing todos
TODO_REPO_PATH=/Users/yourusername/my-todos

# OPTIONAL: Remote Git repository URL for syncing
TODO_REPO_URL=https://github.com/yourusername/my-todos.git

# REQUIRED: Git user configuration
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=your.email@example.com

# OPTIONAL: Auto-sync configuration
AUTO_SYNC=false
SYNC_INTERVAL_SECONDS=300

# OPTIONAL: API server configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# TELEGRAM BOT CONFIGURATION
# REQUIRED: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# REQUIRED: Telegram user ID of authorized user (get from @userinfobot)
TELEGRAM_AUTHORIZED_USER_ID=123456789

# REQUIRED: Ollama API URL for LLM processing
OLLAMA_API_URL=http://localhost:11434

# WHISPER CONFIGURATION (choose one)
# Option 1: Use Whisper API server
WHISPER_API_URL=http://localhost:9000

# Option 2: Use local Whisper model (alternative to API)
# WHISPER_MODEL_PATH=/path/to/whisper/model

# OPTIONAL: Speaker diarization (experimental)
ENABLE_SPEAKER_DIARIZATION=false
MIN_SPEAKERS=1
MAX_SPEAKERS=5

# ============================================
# DOCKER DEPLOYMENT (TELEGRAM BOT)
# ============================================
# For Docker deployment, copy this file to .env.telegram and configure:
#
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_AUTHORIZED_USER_ID=123456789
# TODO_REPO_URL=https://token@github.com/user/repo.git
# GIT_USER_NAME=Telegram Bot
# GIT_USER_EMAIL=bot@example.com
# AUTO_SYNC=true
# SYNC_INTERVAL_SECONDS=60
#
# See .env.telegram.example for complete Docker configuration template
# See docs/DOCKER_DEPLOYMENT.md for detailed deployment guide
