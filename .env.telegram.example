# Telegram Bot Docker Environment Configuration
# Copy this file to .env.telegram and update with your values
# IMPORTANT: Never commit .env.telegram to Git - it contains secrets!

# ============================================
# TELEGRAM BOT CONFIGURATION (REQUIRED)
# ============================================

# Telegram bot token from @BotFather
# Get this by creating a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram user ID of authorized user
# Get your user ID from @userinfobot on Telegram
# You can add multiple IDs separated by commas: 123456789,987654321
TELEGRAM_AUTHORIZED_USER_ID=123456789

# ============================================
# GIT REPOSITORY CONFIGURATION (REQUIRED)
# ============================================

# Path to Git repository inside container (DO NOT CHANGE)
TODO_REPO_PATH=/app/data/todos

# Remote Git repository URL for syncing
# Option 1: HTTPS with personal access token (recommended for simplicity)
# Format: https://TOKEN@github.com/username/repo.git
# Example: https://ghp_xxxxxxxxxxxxxxxxxxxx@github.com/myuser/my-todos.git
#
# Option 2: SSH (requires mounting SSH keys)
# Format: git@github.com:username/repo.git
# Example: git@github.com:myuser/my-todos.git
TODO_REPO_URL=https://your_token@github.com/your_username/your_repo.git

# Git user configuration for commits
# These will appear in Git commit history
GIT_USER_NAME=Telegram Bot
GIT_USER_EMAIL=bot@example.com

# ============================================
# SYNC CONFIGURATION
# ============================================

# Enable automatic sync with remote repository
# Set to 'true' to enable, 'false' to disable
AUTO_SYNC=true

# Sync interval in seconds
# How often to sync with remote repository (default: 60 seconds)
# Recommended: 60-120 for 1-2 users, 30-60 for 3-5 users
SYNC_INTERVAL_SECONDS=60

# ============================================
# MCP SERVER CONFIGURATION
# ============================================

# Path to MCP server inside container (DO NOT CHANGE)
MCP_SERVER_PATH=/app/dist/index.js

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Node environment (production or development)
NODE_ENV=production

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ============================================
# SECURITY NOTES
# ============================================
#
# 1. NEVER commit .env.telegram to Git
# 2. Use personal access tokens with minimal permissions
# 3. Rotate tokens regularly
# 4. For production, consider using Docker secrets
# 5. Restrict bot access to specific user IDs only
#
# GitHub Personal Access Token Setup:
# 1. Go to GitHub Settings > Developer settings > Personal access tokens
# 2. Generate new token (classic)
# 3. Select scopes: repo (full control of private repositories)
# 4. Copy token and use in TODO_REPO_URL
#
# SSH Key Setup (Alternative):
# 1. Generate SSH key: ssh-keygen -t ed25519 -C "bot@example.com"
# 2. Add public key to GitHub: Settings > SSH and GPG keys
# 3. Mount SSH keys in docker-compose.yml:
#    volumes:
#      - ~/.ssh:/home/node/.ssh:ro
# 4. Use SSH URL format in TODO_REPO_URL
